<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built against Roslyn 4.3.1, the compiler in Unity 6000.0 to 6000.3; newer compilers load it too. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TarragonFly.Analyzers</AssemblyName>
    <RootNamespace>TarragonFly.Analyzers</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Deterministic>true</Deterministic>
    <!-- The DLL stores its PDB path, so without this the bytes change whenever the clone sits in a different folder. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <Version>0.3.1</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The forked Unity rule tests read internal descriptors and helpers, as upstream's do. -->
    <InternalsVisibleTo Include="TarragonFly.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
