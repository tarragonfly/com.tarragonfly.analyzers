<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Release tracking is for the shipped analyzer; test-only probe rules are never released. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The analyzer's own Roslyn floor, so tests fail if a rule needs a newer compiler API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Upstream Unity rule tests check which methods the installed editor has. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TarragonFly.Analyzers\TarragonFly.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\StubAssemblies.cs" Link="Harness\StubAssemblies.cs" />
    <None Include="..\..\stubs\*.cs" Link="stubs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- RuleTableTests checks the README's rule table against the descriptors. -->
    <None Include="..\..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
