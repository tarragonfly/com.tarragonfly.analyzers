<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares each TF rule with the rule it replaces. Run through Tools~/Check.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TarragonFly.Analyzers.Parity</AssemblyName>
    <RootNamespace>TarragonFly.Analyzers.Parity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newer than the analyzer's floor: the oracle analyzers load into it as they would into Unity's compiler. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TarragonFly.Analyzers\TarragonFly.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\StubAssemblies.cs" Link="StubAssemblies.cs" />
    <None Include="..\..\stubs\*.cs" Link="stubs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
